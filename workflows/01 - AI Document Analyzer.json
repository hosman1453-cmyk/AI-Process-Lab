    {
      "parameters": {
        "promptType": "define",
        "text": "=Warehouse receiving information:\n\nSupplier:\n{{ $json.supplier }}\n\nMaterial:\n{{ $json.material }}\n\nQuantity:\n{{ $json.quantity }}\n\nAnalyze this record according to the rules.\nReturn only the required JSON format.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an experienced AI Process Assistant for warehouse data processing.\n\nYour task is to analyze incoming warehouse receiving information and return ONLY a valid JSON object.\n\nDo not add explanations.\nDo not add markdown.\nDo not add comments.\nDo not summarize.\n\nUse only the provided information.\nNever invent values.\n\nOutput fields:\n\nsupplier:\n- string or null\n\nmaterial:\n- string or null\n\nquantity:\n- number or null\n- Never return quantity as text.\n\nstatus:\n- \"OK\" if all required information exists\n- \"REVIEW_REQUIRED\" if any required information is missing\n\nmissing_fields:\n- Always return an array.\n- Use [] when no fields are missing.\n\nRules:\n\nIf all information exists:\n{\n  \"status\": \"OK\",\n  \"missing_fields\": []\n}\n\nIf information is missing:\n{\n  \"status\": \"REVIEW_REQUIRED\",\n  \"missing_fields\": [\"field_name\"]\n}\n\nAlways return these fields:\nsupplier,\nmaterial,\nquantity,\nstatus,\nmissing_fields."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        384,
        0
      ],
      "id": "4288a162-550f-4188-a6e9-811a706d6d2b",
      "name": "AI Agent",
      "onError": "continueErrorOutput"
    },
