        "operation": "executeQuery",
        "query": "INSERT INTO ai_process_log\n(\n    record_id,\n    supplier,\n    material,\n    quantity,\n    status,\n    missing_fields,\n    process_step,\n    created_at,\n    workflow_name,\n    workflow_version\n)\nVALUES\n(\n    $1,\n    $2,\n    $3,\n    NULLIF($4, 'null')::integer,\n    $5,\n    $6,\n    $7,\n    $8,\n    $9,\n    $10\n);",
